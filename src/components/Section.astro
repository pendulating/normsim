---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<!-- The divider sits inside the content column, like every rule within a
     section, rather than spanning the viewport. -->
<section id={id} class="pb-10 sm:pb-14">
  <div class="wrap-wide">
    <div class="border-t border-skin-line pt-10 sm:pt-14">
      <h2 class="mb-4 text-[clamp(1.5rem,1.2rem+1.2vw,2rem)]">{title}</h2>
      <slot />
    </div>
  </div>
</section>
