---
import ThemeToggle from './ThemeToggle.astro';
import { paper } from '../data/paper';
import { nav } from '../data/nav';
---

<header
  id="main-header"
  class="themed sticky top-0 z-50 flex min-h-(--header-height) items-center border-b border-skin-line bg-skin-fill/92 backdrop-blur"
>
  <div class="wrap-wide flex items-center justify-between gap-4">
    <a class="site-logo text-[1.05rem] whitespace-nowrap no-underline hover:underline hover:decoration-skin-accent" href="#top"
      >{paper.shortTitle}</a
    >
    <nav aria-label="Sections">
      <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 leading-tight sm:gap-x-4">
        {
          nav.filter((item) => item.header !== false).map((item) => (
            <li>
              <a class="text-sm no-underline hover:underline sm:text-[0.95rem]" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
