---
/* Animated "norm universe extraction" diagram, ported from the Google NYC talk
   deck (the Extract panel of the end-to-end slide plus NormUniverseOrbs.vue),
   then extended with a worked example that follows one real chunk through the
   pipeline. Five click-through steps:

     Source texts -> Chunk -> Reason -> Extract -> Aggregate

   Steps 1 and 5 show the two universes (empty, then populated with real
   extracted norms). Steps 2-4 show a three-panel "bench": the raw chunk, the
   reasoning pass's free-form output for it, and the typed tuples the
   extraction pass produced from that reasoning. On wide screens the panels sit
   on a track that slides left one panel per step; on narrow screens they stack
   in place and cross-fade. Highlighted phrases travel from each panel into the
   next (a small vanilla script clones them and animates the clone).

   Dependency-free: inline SVG + CSS transitions, driven by the script at the
   bottom. It autoplays once when scrolled into view and holds on the final
   step; the step buttons let a reader walk it by hand. Under
   prefers-reduced-motion it renders the final step with no motion, and any
   step a reader picks shows its final state. Without JS the markup already
   shows the final step. */
import { pipeline, steps, universes, workedExample as ex } from '../data/normUniverse';

const last = steps.length - 1;
// Render the literal "𝒩_b" in data strings as 𝒩 with a subscript b.
const mathParts = (s: string) => s.split('𝒩_b');
const byId = Object.fromEntries(pipeline.map((n) => [n.id, n]));
const focusOf = (id: string) =>
  steps
    .map((s, i) => ((s.focus as string[]).includes(id) ? i : -1))
    .filter((i) => i >= 0)
    .join(' ');
const fmt = (n: number) => n.toLocaleString('en-US');

// Reveal order of everything in the Extract panel (drives --i stagger).
const flowSlots = ex.flow.slots.map((s, i) => ({ ...s, i }));
const flowApprop = flowSlots.length;
const normSlots = ex.norm.slots.map((s, i) => ({ ...s, i: flowApprop + 1 + i }));
const normForce = flowApprop + 1 + normSlots.length;
const normArtic = normForce + 1;
---

<div
  class="nu"
  data-nu
  data-step={last}
  data-steps={steps.length}
  data-views={steps.map((s) => s.view).join(' ')}
  data-view={steps[last].view}
>
  <!-- Pipeline: Fiction novels -> Chunks -> Extraction LLM -> CI flows / Norm universes. -->
  <div class="nu-pipe" aria-hidden="true">
    {
      (['books', 'chunks'] as const).map((id) => (
        <Fragment>
          <div class="nu-node" data-focus={focusOf(id)}>
            <span class="nu-node-title">{byId[id].title}</span>
            <span class="nu-node-detail">{byId[id].detail}</span>
          </div>
          <svg class="nu-arrow" viewBox="0 0 32 12">
            <path d="M1 6h27" />
            <path d="M24 2l5 4-5 4" class="nu-head" />
          </svg>
        </Fragment>
      ))
    }
    <div class="nu-node" data-focus={focusOf('llm')}>
      <span class="nu-node-title">{byId.llm.title}</span>
      <span class="nu-node-detail">
        <span class="nu-pass" data-focus={focusOf('reason')}>reason</span>
        {' · '}
        <span class="nu-pass" data-focus={focusOf('extract')}>extract</span>
      </span>
    </div>
    <svg class="nu-fork" viewBox="0 0 32 100" preserveAspectRatio="none">
      <path d="M0 50 C14 50 14 22 32 22" />
      <path d="M0 50 C14 50 14 78 32 78" />
    </svg>
    <div class="nu-outs">
      <div class="nu-node nu-node-out" data-focus={focusOf('flows')}>
        <span class="nu-node-title">{byId.flows.title}</span>
        <span class="nu-node-detail">{byId.flows.detail}</span>
      </div>
      <div class="nu-map">
        <span class="nu-map-line"></span>
        <span class="nu-map-label">map onto</span>
      </div>
      <div class="nu-node nu-node-out" data-focus={focusOf('universes')}>
        <span class="nu-node-title">{byId.universes.title}</span>
        <span class="nu-node-detail nu-math">𝒩<sub>b</sub></span>
      </div>
    </div>
  </div>

  <!-- Step controls. -->
  <div class="nu-controls">
    <ol class="nu-stepper" aria-label="Diagram steps">
      {
        steps.map((s, i) => (
          <li>
            <button type="button" class="nu-step" data-goto={i} aria-current={i === last ? 'step' : undefined}>
              {i + 1} · {s.label}
            </button>
          </li>
        ))
      }
    </ol>
    <div class="nu-buttons">
      <button type="button" class="nu-btn" data-prev aria-label="Previous step">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button type="button" class="nu-btn" data-next aria-label="Next step">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
      <button type="button" class="nu-btn" data-replay aria-label="Replay the animation">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M4 12a8 8 0 1 0 2.4-5.7"></path><path d="M4 4v4.5h4.5"></path></svg
        >
      </button>
    </div>
  </div>

  <p class="nu-live" aria-live="polite">
    {
      steps.map((s, i) => (
        <span data-caption={i} hidden={i !== last}>
          <span class="nu-live-label">
            Step {i + 1} of {steps.length}: {s.label}.
          </span>{' '}
          {mathParts(s.caption).map((part, j) => (
            <Fragment>
              {j > 0 && (
                <span class="nu-math">
                  𝒩<sub>b</sub>
                </span>
              )}
              {part}
            </Fragment>
          ))}
        </span>
      ))
    }
  </p>

  <div class="nu-stage">
    <!-- The two universes. Empty (dashed, 𝒩_b = ∅) until the last step. -->
    <div class="nu-orbs nu-view" data-view-of="orbs">
      {
        universes.map((u) => (
          <div class="nu-col">
            <div class="nu-orb-wrap">
              <div class="nu-orb" aria-hidden="true">
                <span class="nu-empty nu-math">
                  𝒩<sub>b</sub>
                  {' = ∅'}
                </span>
              </div>
              <ul class="nu-chips" aria-label={`Example norms extracted from ${u.title}`}>
                {u.norms.map((n, i) => (
                  <li
                    class:list={['nu-chip', { 'nu-chip-example': n.example }]}
                    style={`--x:${n.x}%;--y:${n.y}%;--nx:${n.nx ?? n.x}%;--ny:${n.ny ?? n.y}%;--dx:${n.dx};--dy:${n.dy};--delay:${n.delay}s;--float:${4.2 + ((i * 0.7) % 2.1)}s`}
                  >
                    <span class="nu-chip-card">
                      <span class="nu-force">
                        {n.force}
                        {n.example && <span class="nu-chip-tag"> · chunk {ex.chunkId}</span>}
                      </span>
                      {n.text}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <p class="nu-caption">
              <span class="nu-title">{u.title}</span>
              <span class="nu-author">· {u.author}</span>
              <span class="nu-count">
                |<span class="nu-math">𝒩<sub>b</sub></span>| = {u.count} norms
              </span>
            </p>
          </div>
        ))
      }
    </div>

    <!-- Worked example: one chunk, its reasoning, and the tuples extracted from it. -->
    <div class="nu-bench nu-view" data-view-of="chunk reason extract">
      <p class="nu-bench-head">
        <span class="nu-title">{ex.book}</span>, chunk {ex.chunkId} of {ex.chunkTotal} ·
        {ex.model}, verbatim output
      </p>
      <div class="nu-viewport">
        <div class="nu-track">
          <!-- 1. The raw chunk. -->
          <section class="nu-panel" data-panel="chunk" aria-label="The source chunk">
            <header class="nu-phead">
              <h4 class="nu-ptitle">Source chunk</h4>
              <span class="nu-pmeta">{fmt(ex.chunkChars)} characters</span>
            </header>
            <svg class="nu-windows" viewBox="0 0 300 38" aria-hidden="true">
              <rect class="nu-win nu-win-dim" x="1" y="19" width="118" height="16" rx="3" />
              <rect class="nu-win nu-win-dim" x="181" y="19" width="118" height="16" rx="3" />
              <rect class="nu-win nu-win-cur" x="91" y="19" width="118" height="16" rx="3" />
              <rect class="nu-win-ov" x="91" y="19" width="28" height="16" />
              <rect class="nu-win-ov" x="181" y="19" width="28" height="16" />
              <text x="45" y="12">{ex.chunkId - 1}</text>
              <text x="150" y="12" class="nu-win-label">{ex.chunkId}</text>
              <text x="255" y="12">{ex.chunkId + 1}</text>
            </svg>
            <p class="nu-windows-note">
              ≤ {fmt(ex.chunkLimit)} characters, split on paragraphs; each chunk opens with the last {
                fmt(ex.overlap)
              } of the one before (shaded).
            </p>
            <div class="nu-doc">
              {
                ex.chunk.map((para) => (
                  <p>
                    {para.map((g) =>
                      g.key ? (
                        <span class="nu-snip" data-key={g.key}>{g.text}</span>
                      ) : g.em ? (
                        <em>{g.text}</em>
                      ) : (
                        g.text
                      ),
                    )}
                  </p>
                ))
              }
              <p class="nu-doc-more" aria-label="text continues">…</p>
            </div>
          </section>

          <!-- 2. The reasoning pass: free-form analysis, emitted as JSON. -->
          <section class="nu-panel" data-panel="reason" aria-label="Reasoning output for the chunk">
            <header class="nu-phead">
              <h4 class="nu-ptitle">Reasoning pass</h4>
              <span class="nu-pmeta">free-form, whole chunk</span>
            </header>
            <div class="nu-rblock">
              <p class="nu-rlabel">
                <code>norms[{ex.normReasoning.index - 1}]</code>
                <span>norm {ex.normReasoning.index} of {ex.normReasoning.total}</span>
              </p>
              <blockquote class="nu-quote nu-land" data-fly="reason" data-from="snip" style="--i:0">
                “{ex.normReasoning.snippet}”
              </blockquote>
              <p class="nu-rtext">
                {
                  ex.normReasoning.reasoning.map((g) =>
                    g.key ? (
                      <mark class="nu-hl" data-key={g.key}>{g.text}</mark>
                    ) : (
                      g.text
                    ),
                  )
                }
              </p>
              <p class="nu-rfield">
                <code>preliminary_normative_force</code>
                <mark class="nu-hl" data-key="n-force">{ex.normReasoning.force}</mark>
              </p>
              <p class="nu-rfield">
                <code>governs_information_flow</code>
                <span>{ex.normReasoning.governsInfoFlow}</span>
              </p>
            </div>
            <div class="nu-rblock">
              <p class="nu-rlabel">
                <code>flows[{ex.flowReasoning.index - 1}]</code>
                <span>flow {ex.flowReasoning.index} of {ex.flowReasoning.total}, same quote</span>
              </p>
              <p class="nu-rtext">
                {
                  ex.flowReasoning.reasoning.map((g) =>
                    g.key ? (
                      <mark class="nu-hl" data-key={g.key}>{g.text}</mark>
                    ) : (
                      g.text
                    ),
                  )
                }
              </p>
              <p class="nu-rfield nu-rfield-block">
                <code>flow_direction</code>
                <span>
                  {
                    ex.flowReasoning.direction.map((g) =>
                      g.key ? (
                        <mark class="nu-hl" data-key={g.key}>{g.text}</mark>
                      ) : (
                        g.text
                      ),
                    )
                  }
                </span>
              </p>
              <p class="nu-rfield">
                <code>potential_appropriateness</code>
                <mark class="nu-hl" data-key="f-approp">{ex.flowReasoning.appropriateness}</mark>
              </p>
            </div>
          </section>

          <!-- 3. The extraction pass: typed tuples under guided decoding. -->
          <section class="nu-panel" data-panel="extract" aria-label="Typed tuples extracted from the reasoning">
            <header class="nu-phead">
              <h4 class="nu-ptitle">Extraction pass</h4>
              <span class="nu-pmeta">guided decoding, one tuple per entry</span>
            </header>
            <div class="nu-tuple">
              <p class="nu-tuple-head">
                <span>CI information flow</span>
                <span class="nu-math">(s, r, u, a, t)</span>
              </p>
              <dl class="nu-slots">
                {
                  flowSlots.map((s) => (
                    <Fragment>
                      <dt>
                        <span class="nu-sym">{s.sym}</span> {s.label}
                      </dt>
                      <dd class="nu-land" data-fly="extract" data-from={s.from} style={`--i:${s.i}`}>
                        {s.value}
                      </dd>
                    </Fragment>
                  ))
                }
              </dl>
              <p class="nu-annots">
                <span class="nu-annot nu-land" data-fly="extract" data-from="f-approp" style={`--i:${flowApprop}`}>
                  appropriateness <b>{ex.flow.appropriateness}</b>
                </span>
                <span class="nu-annot">
                  context <b>{ex.flow.context}</b>
                </span>
              </p>
            </div>
            <div class="nu-tuple">
              <p class="nu-tuple-head">
                <span>Raz norm</span>
                <span class="nu-math">(d, s, a, c)</span>
              </p>
              <dl class="nu-slots">
                {
                  normSlots.map((s) => (
                    <Fragment>
                      <dt>
                        <span class="nu-sym">{s.sym}</span> {s.label}
                      </dt>
                      <dd class="nu-land" data-fly="extract" data-from={s.from} style={`--i:${s.i}`}>
                        {s.value}
                      </dd>
                    </Fragment>
                  ))
                }
              </dl>
              <p class="nu-annots">
                <span class="nu-annot nu-land" data-fly="extract" data-from="n-force" style={`--i:${normForce}`}>
                  normative force <b>{ex.norm.force}</b>
                </span>
                <span class="nu-annot">
                  governs info flow <b>{ex.norm.governsInfoFlow}</b>
                </span>
                <span class="nu-annot">
                  context <b>{ex.norm.context}</b>
                </span>
              </p>
              <p class="nu-artic nu-land" style={`--i:${normArtic}`}>
                <span class="nu-artic-label">
                  articulation, enters <span class="nu-math">𝒩<sub>b</sub></span>
                </span>
                “{ex.norm.articulation}”
              </p>
            </div>
            <p class="nu-note">
              Flows keep character names. Norms pass through a role-abstraction step before aggregation; this
              subject is already a role, so it enters <span class="nu-math">𝒩<sub>b</sub></span> unchanged.
            </p>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nu {
    --nu-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --nu-ink-faint: rgba(var(--color-text-base), 0.16);
    --nu-ink-soft: rgba(var(--color-text-base), 0.4);
    /* Timings shared with the script: the track slides for --nu-slide, then
       the extracted values reveal from --nu-reveal, --nu-stagger apart. */
    --nu-slide: 0.8s;
    --nu-reveal: 0.35s;
    --nu-stagger: 0.11s;
    position: relative;
    /* Chips drift in from outside their orb; never let that scroll the page. */
    overflow-x: clip;
  }

  .nu-math {
    font-style: italic;
    white-space: nowrap;
  }
  .nu-math sub {
    font-size: 0.7em;
  }

  /* ---------- Pipeline ---------- */
  .nu-pipe {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) 1.75rem minmax(0, 0.85fr) 1.75rem minmax(0, 1.05fr) 2rem
      minmax(0, 1.1fr);
    align-items: center;
    max-width: 52rem;
    margin: 0 auto;
    font-size: 0.95rem;
  }
  .nu-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.55rem 0.5rem;
    border: 1.5px solid var(--nu-ink-faint);
    border-radius: 0.5rem;
    background: rgb(var(--color-card));
    text-align: center;
    line-height: 1.2;
    transition: var(--theme-transition), border-color 0.45s ease, opacity 0.45s ease;
  }
  .nu-node-title {
    font-weight: 700;
  }
  .nu-node-detail {
    font-weight: 500;
    font-size: 0.82em;
    opacity: 0.75;
  }
  .nu-node.is-focus {
    border-color: rgb(var(--color-accent));
  }
  .nu-node.is-focus .nu-node-title {
    color: rgb(var(--color-accent));
  }
  /* The two passes named inside the LLM node light up one at a time. */
  .nu-pass {
    border-bottom: 1.5px solid transparent;
    transition: var(--theme-transition), border-color 0.45s ease;
  }
  .nu-pass.is-focus {
    color: rgb(var(--color-accent));
    font-weight: 700;
    border-bottom-color: rgb(var(--color-accent));
  }
  .nu-arrow,
  .nu-fork {
    width: 100%;
    fill: none;
    stroke: var(--nu-ink-soft);
    stroke-width: 1.5;
    overflow: visible;
  }
  .nu-arrow {
    height: 0.75rem;
  }
  .nu-fork {
    align-self: stretch;
    height: 100%;
  }
  .nu-fork path {
    vector-effect: non-scaling-stroke;
  }
  .nu-head {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nu-outs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .nu-map {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 1.9rem;
  }
  .nu-map-line {
    width: 0;
    height: 100%;
    border-left: 1.5px dashed var(--nu-ink-soft);
  }
  .nu-map-label {
    font-size: 0.78rem;
    font-weight: 500;
    opacity: 0.7;
  }

  /* ---------- Stage: orbs and bench share one grid cell ---------- */
  /* Only the active view is in flow, so the stage is exactly as tall as
     what is on show; the controls above it never move. */
  .nu-stage {
    position: relative;
    display: grid;
    margin-top: 1.5rem;
    overflow: clip;
    overflow-clip-margin: 0.5rem;
  }
  .nu-view {
    grid-area: 1 / 1;
    align-self: start;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.5s ease,
      transform 0.6s var(--nu-ease),
      visibility 0s linear 0.5s;
  }
  .nu[data-view='orbs'] .nu-orbs,
  .nu:not([data-view='orbs']) .nu-bench {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.15s, 0.15s, 0s;
  }
  .nu:not([data-view='orbs']) .nu-orbs,
  .nu[data-view='orbs'] .nu-bench {
    position: absolute;
    inset: 0 0 auto;
  }

  /* ---------- Orbs ---------- */
  .nu-orbs {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .nu-orbs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .nu-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .nu-orb-wrap {
    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 1;
    container-type: inline-size;
  }
  .nu-orb {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px dashed var(--nu-ink-soft);
    background: radial-gradient(
      circle at 35% 30%,
      rgba(var(--color-text-base), 0.07),
      rgba(var(--color-text-base), 0.015) 70%
    );
    transition: var(--theme-transition), border-color 0.8s ease, box-shadow 0.8s ease;
  }
  .nu-empty sub {
    margin-right: 0.25em;
  }
  .nu-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    opacity: 0.55;
    transition: opacity 0.5s ease;
  }
  .nu-chips {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nu-chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 40cqw;
    font-size: clamp(10px, 2.75cqw, 12px);
    line-height: 1.3;
    opacity: 0;
    transform: translate(calc(-50% + var(--dx) * 1cqw), calc(-50% + var(--dy) * 1cqw)) scale(0.35);
    transition:
      opacity 0.5s ease,
      transform 1.1s var(--nu-ease);
  }
  .nu-chip-card {
    display: block;
    padding: 0.35em 0.55em 0.4em;
    border: 1px solid var(--nu-ink-faint);
    border-left: 3px solid var(--nu-ink-soft);
    border-radius: 6px;
    background: rgb(var(--color-fill));
    box-shadow: 0 2px 8px rgba(var(--color-text-base), 0.1);
    text-align: left;
    transition: var(--theme-transition);
  }
  /* The worked example's norm: same chip, a firmer edge and a source tag. */
  .nu-chip-example .nu-chip-card {
    border-color: var(--nu-ink-soft);
    border-left-color: rgb(var(--color-text-base));
  }
  .nu-force {
    display: block;
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0.03em;
    opacity: 0.65;
  }
  .nu-chip-tag {
    font-weight: 700;
    white-space: nowrap;
  }
  .nu-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    column-gap: 0.4rem;
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }
  .nu-title {
    font-weight: 700;
    font-style: italic;
  }
  .nu-author,
  .nu-count {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .nu-author {
    opacity: 0.65;
  }
  .nu-count {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  /* Populated (final step). */
  .nu.is-populated .nu-orb {
    border-style: solid;
    border-color: rgba(var(--color-accent), 0.8);
    box-shadow:
      0 0 28px -8px rgba(var(--color-accent), 0.55),
      inset 0 0 50px -24px rgba(var(--color-accent), 0.55);
  }
  .nu.is-populated .nu-empty {
    opacity: 0;
  }
  .nu.is-populated .nu-chip {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition-delay: var(--delay);
  }
  .nu.is-populated .nu-chip-card {
    animation: nu-float var(--float) ease-in-out 1.6s infinite alternate;
  }
  .nu.is-populated .nu-count {
    opacity: 1;
    transition-delay: 0.9s;
  }
  @keyframes nu-float {
    to {
      transform: translate(3px, -5px);
    }
  }

  /* ---------- Bench: the worked example ---------- */
  .nu-bench {
    --nu-gap: 3rem;
    align-self: start;
  }
  .nu-bench-head {
    margin: 0 0 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: center;
    opacity: 0.8;
  }
  /* Sized by the script to the panels on show, so a taller panel that has
     slid away or is still ahead leaves no blank under the current one. */
  .nu-viewport {
    overflow: clip;
    overflow-clip-margin: 0.25rem;
  }
  .nu-track {
    display: grid;
  }
  .nu-panel {
    grid-area: 1 / 1;
    align-self: start;
    position: relative;
    min-width: 0;
    padding: 0.9rem 1rem 1rem;
    border: 1.5px solid var(--nu-ink-faint);
    border-radius: 0.6rem;
    background: rgb(var(--color-card));
    font-size: 0.875rem;
    line-height: 1.5;
    transition:
      var(--theme-transition),
      opacity 0.5s ease,
      transform 0.6s var(--nu-ease),
      visibility 0s linear 0.5s;
  }
  .nu-panel[data-state='current'] {
    border-color: rgba(var(--color-accent), 0.6);
  }
  /* Narrow: panels stack in one cell; only the current one shows. */
  .nu-panel:not([data-state='current']) {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
  }
  .nu-panel[data-state='current'] {
    transition-delay: 0s, 0.1s, 0.1s, 0s;
  }

  @media (min-width: 900px) {
    /* Wide: a track of three half-width panels that slides one panel per
       step, so the panel just finished stays beside the one it feeds. */
    .nu-track {
      display: flex;
      align-items: flex-start;
      gap: var(--nu-gap);
      transition: transform var(--nu-slide) var(--nu-ease);
    }
    .nu-panel {
      grid-area: auto;
      flex: 0 0 calc(50% - var(--nu-gap) / 2);
    }
    .nu[data-view='chunk'] .nu-track {
      transform: translateX(calc(25% + var(--nu-gap) / 4));
    }
    .nu[data-view='extract'] .nu-track {
      transform: translateX(calc(-50% - var(--nu-gap) / 2));
    }
    .nu-panel[data-state='past'] {
      opacity: 0.5;
      visibility: visible;
      transform: none;
    }
    /* Arrow in the gap, pointing into each panel from the one before. */
    .nu-panel + .nu-panel::before,
    .nu-panel + .nu-panel::after {
      content: '';
      position: absolute;
      top: 9rem;
      border-top: 1.5px solid var(--nu-ink-soft);
    }
    .nu-panel + .nu-panel::before {
      left: calc(-1 * var(--nu-gap) + 0.7rem);
      width: calc(var(--nu-gap) - 1.3rem);
    }
    .nu-panel + .nu-panel::after {
      left: calc(-0.6rem - 0.55rem);
      width: 0.55rem;
      height: 0.55rem;
      margin-top: calc(-0.275rem + 0.1rem);
      border-right: 1.5px solid var(--nu-ink-soft);
      transform: rotate(45deg);
    }
    .nu {
      --nu-reveal: 1.2s;
    }
  }

  .nu-phead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 0.75rem;
    margin-bottom: 0.6rem;
  }
  .nu-ptitle {
    margin: 0;
    font-size: 1rem;
  }
  .nu-pmeta {
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.75;
  }

  /* Chunk panel. */
  .nu-windows {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    overflow: visible;
  }
  .nu-win {
    fill: rgb(var(--color-fill));
    stroke-width: 1.25;
    transition: var(--theme-transition);
  }
  .nu-win-dim {
    stroke: var(--nu-ink-soft);
    stroke-dasharray: 3 2.5;
  }
  .nu-win-cur {
    stroke: rgb(var(--color-text-base));
    stroke-width: 1.75;
  }
  .nu-win-ov {
    fill: rgba(var(--color-text-base), 0.18);
  }
  .nu-windows text {
    fill: rgb(var(--color-text-base));
    font-size: 12px;
    font-weight: 500;
    text-anchor: middle;
    opacity: 0.65;
  }
  .nu-windows .nu-win-label {
    font-weight: 700;
    opacity: 1;
  }
  .nu-windows-note {
    margin: 0.3rem 0 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.75;
  }
  .nu-doc {
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--nu-ink-faint);
    border-radius: 0.4rem;
    background: rgb(var(--color-fill));
    box-shadow: 0 1px 4px rgba(var(--color-text-base), 0.06);
    transition: var(--theme-transition);
  }
  .nu-doc p {
    margin: 0 0 0.55em;
  }
  .nu-doc .nu-doc-more {
    margin: 0;
    opacity: 0.6;
  }
  .nu-snip {
    background: rgba(var(--color-text-base), 0.08);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-bottom: 1.5px solid var(--nu-ink-soft);
    transition: var(--theme-transition), background-color 0.4s ease;
  }
  .nu[data-view='chunk'] .nu-snip {
    background: rgba(var(--color-accent), 0.14);
    border-bottom-color: rgb(var(--color-accent));
  }

  /* Reasoning panel. */
  .nu-rblock + .nu-rblock {
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--nu-ink-faint);
  }
  .nu-rlabel {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.75;
  }
  .nu code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.75rem;
  }
  .nu-quote {
    margin: 0 0 0.45rem;
    padding: 0.05rem 0 0.05rem 0.65rem;
    border-left: 2px solid var(--nu-ink-soft);
    font-style: italic;
  }
  .nu-rtext {
    margin: 0 0 0.4rem;
  }
  .nu-rfield {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.55rem;
    margin: 0.15rem 0 0;
  }
  .nu-rfield code {
    opacity: 0.7;
  }
  .nu-hl {
    color: inherit;
    background: rgba(var(--color-text-base), 0.07);
    border-bottom: 1.5px solid var(--nu-ink-soft);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: var(--theme-transition), background-color 0.4s ease;
  }
  .nu[data-view='reason'] .nu-hl,
  .nu[data-view='extract'] .nu-hl {
    background: rgba(var(--color-accent), 0.14);
    border-bottom-color: rgb(var(--color-accent));
  }

  /* Extraction panel. */
  .nu-tuple {
    padding: 0.65rem 0.8rem 0.7rem;
    border: 1px solid var(--nu-ink-faint);
    border-radius: 0.45rem;
    background: rgb(var(--color-fill));
    transition: var(--theme-transition);
  }
  .nu-tuple + .nu-tuple {
    margin-top: 0.7rem;
  }
  .nu-tuple-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.45rem;
    font-weight: 700;
  }
  .nu-tuple-head .nu-math {
    font-weight: 500;
    opacity: 0.75;
  }
  .nu-slots {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.3rem 0.75rem;
    margin: 0;
  }
  .nu-slots dt {
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.6;
    opacity: 0.75;
  }
  .nu-sym {
    display: inline-block;
    min-width: 0.9em;
    font-style: italic;
    font-weight: 700;
  }
  .nu-slots dd {
    margin: 0;
    padding-left: 0.5rem;
    border-left: 2px solid var(--nu-ink-faint);
    font-weight: 700;
  }
  .nu[data-view='extract'] .nu-slots dd {
    border-left-color: rgb(var(--color-accent));
  }
  .nu-annots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
  }
  .nu-annot {
    padding: 0.05rem 0.55rem;
    border: 1px solid var(--nu-ink-soft);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .nu-artic {
    margin: 0.55rem 0 0;
    font-style: italic;
  }
  .nu-artic-label {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 500;
    opacity: 0.75;
  }
  .nu-note {
    margin: 0.65rem 0 0;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.75;
  }

  /* Values that arrive from the previous panel: hidden until their view, then
     revealed in order. The script times its travelling clones to match. */
  .nu-land {
    transition: opacity 0.35s ease;
  }
  .nu[data-view='chunk'] [data-panel='reason'] .nu-land,
  .nu[data-view='chunk'] [data-panel='extract'] .nu-land,
  .nu[data-view='reason'] [data-panel='extract'] .nu-land {
    opacity: 0;
    transition: none;
  }
  .nu[data-view='reason'] [data-panel='reason'] .nu-land,
  .nu[data-view='extract'] [data-panel='extract'] .nu-land {
    transition-delay: calc(var(--nu-reveal) + var(--i, 0) * var(--nu-stagger));
  }

  /* The travelling copy of a highlighted phrase (created by the script). */
  :global(.nu-fly) {
    position: absolute;
    z-index: 5;
    margin: 0;
    padding: 0 0.15em;
    border-radius: 3px;
    background: rgb(var(--color-fill));
    color: rgb(var(--color-accent));
    box-shadow:
      0 0 0 1.5px rgba(var(--color-accent), 0.7),
      0 4px 14px rgba(var(--color-text-base), 0.18);
    font-weight: 700;
    line-height: 1.4;
    pointer-events: none;
    transform-origin: 0 0;
    will-change: transform, opacity;
  }

  /* ---------- Controls ---------- */
  .nu-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin-top: 1.75rem;
  }
  .nu-stepper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nu-step {
    padding: 0.2rem 0.3rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: rgba(var(--color-text-base), 0.6);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--theme-transition), border-color 0.4s ease;
  }
  .nu-step:hover {
    color: rgb(var(--color-text-base));
  }
  .nu-step[aria-current='step'] {
    color: rgb(var(--color-text-base));
    font-weight: 700;
    border-bottom-color: rgb(var(--color-accent));
  }
  .nu-buttons {
    display: flex;
    gap: 0.4rem;
  }
  .nu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1.5px solid rgba(var(--color-text-base), 0.35);
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--color-text-base));
    cursor: pointer;
    transition: var(--theme-transition);
  }
  .nu-btn:hover:not([aria-disabled='true']) {
    background: rgb(var(--color-card));
  }
  .nu-btn[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }
  .nu-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nu-live {
    max-width: 40rem;
    min-height: 4.8em;
    margin: 0.9rem auto 0;
    font-size: 0.95rem;
    text-align: center;
  }
  .nu-live-label {
    font-weight: 700;
  }

  /* Narrow screens: tighter pipeline, nothing under 12px. */
  @media (max-width: 559px) {
    .nu-pipe {
      grid-template-columns:
        minmax(0, 1fr) 0.8rem minmax(0, 0.9fr) 0.8rem minmax(0, 1.05fr) 0.9rem
        minmax(0, 1.05fr);
      font-size: 12px;
    }
    .nu-node {
      padding: 0.4rem 0.2rem;
      border-radius: 0.4rem;
    }
    .nu-node-detail,
    .nu-map-label {
      font-size: 12px;
    }
    .nu-chip {
      left: var(--nx);
      top: var(--ny);
      width: 43cqw;
      font-size: 12px;
      line-height: 1.25;
    }
    .nu-force {
      font-size: 12px;
    }
    .nu-panel {
      padding: 0.8rem 0.8rem 0.9rem;
    }
    .nu-slots {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.05rem;
    }
    .nu-slots dd {
      margin-bottom: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nu *,
    .nu.is-populated .nu-chip,
    .nu.is-populated .nu-count {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const STEP_MS = 2600;
  /** Extra dwell on the dense middle steps, which have text to read. */
  const DWELL_MS: Record<string, number> = { chunk: 4200, reason: 6000, extract: 6500 };
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = () => window.matchMedia('(min-width: 900px)').matches;
  const PANELS = ['chunk', 'reason', 'extract'];

  document.querySelectorAll<HTMLElement>('[data-nu]').forEach((root) => {
    const total = Number(root.dataset.steps);
    const last = total - 1;
    const focusables = root.querySelectorAll<HTMLElement>('[data-focus]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const stepBtns = root.querySelectorAll<HTMLButtonElement>('[data-goto]');
    const captions = root.querySelectorAll<HTMLElement>('[data-caption]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    // Step index -> view name, read from the step buttons' order in the data.
    const views = (root.dataset.views ?? '').split(' ');
    const viewport = root.querySelector<HTMLElement>('.nu-viewport')!;

    let step = last;
    let timer: number | undefined;
    let autoplay = false; // true while the on-view sequence is still running
    let inView = false;

    // ---- Travelling phrases -------------------------------------------------
    const flyTimers: number[] = [];
    const flyNodes: HTMLElement[] = [];
    const cssTime = (name: string) => {
      const v = getComputedStyle(root).getPropertyValue(name).trim();
      return v.endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000;
    };

    function clearFlights() {
      flyTimers.splice(0).forEach((t) => window.clearTimeout(t));
      flyNodes.splice(0).forEach((n) => n.remove());
    }

    /** Clone each source phrase and move the clone onto the element it
     *  becomes, fading out as that element fades in. Wide layout only, where
     *  source and target panels are both on screen. */
    function fly(view: string) {
      if (reduced() || !wide()) return;
      const reveal = cssTime('--nu-reveal');
      const stagger = cssTime('--nu-stagger');
      const slide = cssTime('--nu-slide');
      const DUR = 720;
      root.querySelectorAll<HTMLElement>(`[data-fly="${view}"]`).forEach((target) => {
        const source = root.querySelector<HTMLElement>(`[data-key="${target.dataset.from}"]`);
        if (!source) return;
        const i = Number(getComputedStyle(target).getPropertyValue('--i')) || 0;
        const arrive = reveal + i * stagger + 120;
        const start = Math.max(slide + 20, arrive - DUR);
        flyTimers.push(
          window.setTimeout(() => {
            if (root.dataset.view !== view) return;
            const box = root.getBoundingClientRect();
            const a = source.getBoundingClientRect();
            const b = target.getBoundingClientRect();
            const clone = document.createElement('span');
            clone.className = 'nu-fly';
            clone.textContent = source.textContent;
            clone.setAttribute('aria-hidden', 'true');
            clone.style.fontSize = getComputedStyle(source).fontSize;
            clone.style.left = `${a.left - box.left}px`;
            clone.style.top = `${a.top - box.top}px`;
            clone.style.maxWidth = `${Math.max(a.width, 120)}px`;
            root.appendChild(clone);
            flyNodes.push(clone);
            const c = clone.getBoundingClientRect();
            const sx = Math.min(1.15, Math.max(0.45, b.width / c.width));
            const dx = b.left - a.left;
            const dy = b.top - a.top + (b.height - c.height * sx) / 2;
            const anim = clone.animate(
              [
                { transform: 'translate(0, 0) scale(1)', opacity: 0 },
                { transform: 'translate(0, 0) scale(1)', opacity: 1, offset: 0.12 },
                { transform: `translate(${dx}px, ${dy}px) scale(${sx})`, opacity: 1, offset: 0.82 },
                { transform: `translate(${dx}px, ${dy}px) scale(${sx})`, opacity: 0 },
              ],
              { duration: DUR, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'forwards' },
            );
            anim.onfinish = () => clone.remove();
          }, start),
        );
      });
    }

    // ---- Steps --------------------------------------------------------------
    function render(i: number) {
      const from = step;
      step = Math.max(0, Math.min(last, i));
      const view = views[step] || 'orbs';
      clearFlights();
      root.dataset.step = String(step);
      root.dataset.view = view;
      root.classList.toggle('is-populated', step === last);
      focusables.forEach((n) => {
        const focus = (n.dataset.focus ?? '').split(' ').filter(Boolean).map(Number);
        n.classList.toggle('is-focus', focus.includes(step));
      });
      // Panel states: before the bench everything is ahead; after it, past.
      const at = PANELS.indexOf(view);
      const pos = at >= 0 ? at : step === 0 ? -1 : PANELS.length;
      panels.forEach((p) => {
        const k = PANELS.indexOf(p.dataset.panel ?? '');
        p.dataset.state = k < pos ? 'past' : k === pos ? 'current' : 'ahead';
      });
      stepBtns.forEach((b) => {
        if (Number(b.dataset.goto) === step) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
      });
      captions.forEach((c) => (c.hidden = Number(c.dataset.caption) !== step));
      // aria-disabled rather than disabled, so a focused button keeps focus
      // when it reaches the end of the sequence.
      prev.setAttribute('aria-disabled', String(step === 0));
      next.setAttribute('aria-disabled', String(step === last));
      fit();
      if (step === from + 1) fly(view);
    }

    /* Size the bench's viewport to the panels on show (the current one and,
       on wide screens, the one before it beside it), so a taller panel that
       has slid away or is still ahead leaves no blank under the current. */
    function fit() {
      const list = [...panels];
      const at = list.findIndex((p) => p.dataset.state === 'current');
      const shown = at < 0 ? [] : wide() ? list.slice(Math.max(0, at - 1), at + 1) : [list[at]];
      const inner = Math.max(0, ...shown.map((p) => p.offsetHeight));
      if (inner) viewport.style.height = `${inner}px`;
    }

    function stop() {
      autoplay = false;
      window.clearTimeout(timer);
    }

    function tick() {
      window.clearTimeout(timer);
      if (!autoplay || !inView) return;
      if (step >= last) {
        autoplay = false; // hold on the final state
        return;
      }
      timer = window.setTimeout(
        () => {
          render(step + 1);
          tick();
        },
        DWELL_MS[views[step]] ?? STEP_MS,
      );
    }

    function play() {
      step = -1;
      render(0);
      if (reduced()) {
        render(last);
        return;
      }
      autoplay = true;
      tick();
    }

    stepBtns.forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        render(Number(b.dataset.goto));
      }),
    );
    prev.addEventListener('click', () => {
      stop();
      render(step - 1);
    });
    next.addEventListener('click', () => {
      stop();
      render(step + 1);
    });
    replay.addEventListener('click', play);
    root.addEventListener('keydown', (e) => {
      if (!(e.target instanceof HTMLButtonElement)) return;
      if (e.key === 'ArrowRight') {
        stop();
        render(step + 1);
      } else if (e.key === 'ArrowLeft') {
        stop();
        render(step - 1);
      } else return;
      e.preventDefault();
    });

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      panels.forEach((p) => ro.observe(p));
    }
    window.matchMedia('(min-width: 900px)').addEventListener('change', fit);

    if (reduced() || !('IntersectionObserver' in window)) {
      render(last);
      return;
    }

    // Start empty; play once the diagram is meaningfully on screen.
    step = -1;
    render(0);
    let started = false;
    new IntersectionObserver(
      (entries) => {
        inView = entries.some((e) => e.isIntersecting);
        if (inView && !started) {
          started = true;
          autoplay = true;
        }
        tick(); // resumes on re-entry, pauses (clears the timer) on exit
      },
      { threshold: 0.2 },
    ).observe(root);
  });
</script>
