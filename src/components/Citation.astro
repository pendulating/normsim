---
import Section from './Section.astro';
import { paper } from '../data/paper';
---

<Section id="cite" title="Citation">
  <p>If you build on this work, please cite the {paper.venue} paper.</p>
  <div class="card relative mt-5 overflow-x-auto p-4">
    <button
      id="copy-bibtex"
      type="button"
      class="project-button absolute top-3 right-3 px-3 py-1.5 text-[0.85rem] data-[state=copied]:border-dashed"
      data-copy-target="bibtex"
      data-copy-status="copy-status">Copy BibTeX</button
    >
    <pre class="code-block m-0 pt-9 sm:pt-0 sm:pr-28 whitespace-pre"><code id="bibtex">{paper.bibtex}</code></pre>
  </div>
  <p id="copy-status" class="caption mt-2 min-h-[1.25rem]" role="status" aria-live="polite"></p>
</Section>

<script>
  function copyText(text: string): Promise<void> {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise((resolve, reject) => {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-1000px';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy') ? resolve() : reject(new Error('copy failed'));
      } catch (e) {
        reject(e);
      } finally {
        document.body.removeChild(ta);
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
    const target = document.getElementById(btn.dataset.copyTarget ?? '');
    const status = document.getElementById(btn.dataset.copyStatus ?? '');
    if (!target) return;
    const idle = btn.textContent;
    btn.addEventListener('click', () => {
      copyText(target.textContent ?? '').then(
        () => {
          btn.textContent = 'Copied';
          btn.dataset.state = 'copied';
          if (status) status.textContent = 'BibTeX copied to clipboard.';
          setTimeout(() => {
            btn.textContent = idle;
            delete btn.dataset.state;
          }, 1800);
        },
        () => {
          const range = document.createRange();
          range.selectNodeContents(target);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          if (status)
            status.textContent = 'Clipboard unavailable. The citation is selected; press Ctrl+C or Cmd+C.';
        }
      );
    });
  });
</script>
