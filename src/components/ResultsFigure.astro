---
/* Step 3, the benchmark results as dot plots, one metric at a time. A row of
   metric buttons drives two cards: zero-shot vs. SFT for the 11 task LLMs
   (a dumbbell per model, the teacher as a dashed reference) and Qwen3.5-9B
   through every RL arm (one dot per arm, the SFT base as a dashed reference).
   Both cards share one axis per metric, so the RL arms' spread reads at the
   same scale as the SFT effect. A third card, independent of the metric, plots
   held-out normative alignment with its bootstrap intervals.

   Encoding follows the paper's tables: a hollow marker is a run below the
   strict-format parse gate, a bold value is in the column's statistical tie
   set. Every panel carries a table view. No-JS readers get the first metric. */
import { metrics, zeroShotSft, rlStage, grounding, type Cell, type Metric } from '../data/results';

const first = metrics[0].key;
const has = (c: Cell) => c.v != null;

/** Nice ticks over the metric's values, clamped to its bounds. */
function axis(m: Metric) {
  const vals = [
    ...zeroShotSft.models.flatMap((r) => [r.zeroShot[m.key], r.sft[m.key]]),
    zeroShotSft.teacher.cells[m.key],
    ...rlStage.map((r) => r.cells[m.key]),
  ]
    .filter(has)
    .map((c) => c.v!);
  const lo = Math.min(...vals);
  const hi = Math.max(...vals);
  const raw = Math.max(hi - lo, 1e-9) / 4;
  const p = 10 ** Math.floor(Math.log10(raw));
  const step = [1, 2, 2.5, 5, 10].find((k) => k * p >= raw)! * p;
  const a = Math.max(m.bounds[0], Math.floor(lo / step) * step);
  const b = Math.min(m.bounds[1], Math.ceil(hi / step) * step);
  const ticks: number[] = [];
  for (let t = a; t <= b + step / 1e6; t += step) ticks.push(Math.round(t * 1e6) / 1e6);
  return { a, b, ticks, at: (v: number) => `${(((v - a) / (b - a)) * 100).toFixed(2)}%` };
}

const fmtFor = (m: Metric) => (v: number) => {
  const s = m.key === 'ci_net' ? v.toFixed(2) : v.toFixed(1);
  return s.replace('-', '−');
};
const statusText = { missing: 'not reported', na: 'unscoreable' };

/** "After SFT: 6 improve, 4 decline, 1 unchanged", respecting the metric's direction. */
function shift(m: Metric) {
  let up = 0;
  let down = 0;
  let same = 0;
  for (const r of zeroShotSft.models) {
    const z = r.zeroShot[m.key];
    const s = r.sft[m.key];
    if (!has(z) || !has(s)) continue;
    const d = (s.v! - z.v!) * (m.lower ? -1 : 1);
    if (d > 0) up++;
    else if (d < 0) down++;
    else same++;
  }
  return { up, down, same };
}
const gated = (m: Metric) =>
  zeroShotSft.models.flatMap((r) => [r.zeroShot[m.key], r.sft[m.key]]).filter((c) => c.gate).length;

const panels = metrics.map((m) => ({
  m,
  ax: axis(m),
  fmt: fmtFor(m),
  shift: shift(m),
  gated: gated(m),
  base: rlStage.find((r) => r.kind === 'base')!.cells[m.key],
  teacher: zeroShotSft.teacher.cells[m.key],
}));
const benches = [...new Set(metrics.map((m) => m.bench))];
const rlGroups = [
  { label: null, rows: rlStage.filter((r) => r.kind === 'ref' || r.kind === 'base') },
  { label: 'GRPO arms', rows: rlStage.filter((r) => r.arm.startsWith('GRPO')) },
  { label: 'KTO arms', rows: rlStage.filter((r) => r.arm.startsWith('KTO') || r.arm === 'SFT control') },
];
const rlRows = rlGroups.reduce((n, g) => n + g.rows.length + (g.label ? 1 : 0), 0);

const gAxis = { a: -0.02, b: 0.16, ticks: [0, 0.05, 0.1, 0.15] };
const gAt = (v: number) => `${(((v - gAxis.a) / (gAxis.b - gAxis.a)) * 100).toFixed(2)}%`;
const k3 = (v: number) => v.toFixed(3).replace('-', '−');
---

<div class="rs" data-rs>
  <div class="rs-tabs" role="group" aria-label="Benchmark metric">
    {
      benches.map((b) => (
        <div class="rs-tab-group">
          <span class="rs-tab-bench">{b}</span>
          <span class="rs-tab-row">
            {metrics
              .filter((m) => m.bench === b)
              .map((m) => (
                <button type="button" class="rs-tab" data-metric={m.key} aria-pressed={m.key === first ? 'true' : 'false'}>
                  {m.name}
                  {m.lower && <span class="rs-down"> ↓</span>}
                </button>
              ))}
          </span>
        </div>
      ))
    }
  </div>

  {
    panels.map(({ m }) => (
      <p class:list={['rs-metric', { 'is-on': m.key === first }]} data-panel={m.key}>
        <b>
          {m.bench} · {m.name}
        </b>{' '}
        {m.detail}. {m.lower ? 'Lower is better.' : 'Higher is better.'}
      </p>
    ))
  }

  <div class="rs-cards">
    <!-- A. Zero-shot vs. SFT. -->
    <section class="rs-card" aria-label="Zero-shot versus SFT">
      <header class="rs-head">
        <h4>Zero-shot vs. SFT, 11 task LLMs</h4>
        <span class="rs-meta">each model’s instruct checkpoint, then its SFT adapter</span>
      </header>
      <p class="rs-legend">
        <span><span class="rs-key rs-key-ref"></span>zero-shot</span>
        <span><span class="rs-key rs-key-sft"></span>SFT</span>
        <span><span class="rs-key rs-key-gate"></span>below the parse gate</span>
        <span><span class="rs-key-line"></span>Gemma-4-31B-it teacher</span>
      </p>
      {
        panels.map(({ m, ax, fmt, shift, gated, teacher }) => (
          <div class:list={['rs-panel', { 'is-on': m.key === first }]} data-panel={m.key}>
            <div class="rs-plot" style={`grid-template-rows: repeat(${zeroShotSft.models.length}, auto) auto`}>
              <div class="rs-grid" style={`grid-row: 1 / ${zeroShotSft.models.length + 1}`} aria-hidden="true">
                {ax.ticks.map((t) => (
                  <span class="rs-gridline" style={`left:${ax.at(t)}`} />
                ))}
                {has(teacher) && <span class="rs-refline" style={`left:${ax.at(teacher.v!)}`} />}
              </div>
              {zeroShotSft.models.map((r) => {
                const z = r.zeroShot[m.key];
                const s = r.sft[m.key];
                const both = has(z) && has(s);
                return (
                  <Fragment>
                    <span class="rs-label">{r.model}</span>
                    <span class="rs-track">
                      {both && (
                        <span
                          class="rs-span"
                          style={`left:${ax.at(Math.min(z.v!, s.v!))}; right:calc(100% - ${ax.at(Math.max(z.v!, s.v!))})`}
                        />
                      )}
                      {has(z) && (
                        <span
                          class:list={['rs-dot rs-dot-ref', { 'is-gate': z.gate }]}
                          style={`left:${ax.at(z.v!)}`}
                          title={`${r.model}, zero-shot: ${fmt(z.v!)}${z.gate ? ' (below the parse gate)' : ''}`}
                        />
                      )}
                      {has(s) && (
                        <span
                          class:list={['rs-dot rs-dot-sft', { 'is-gate': s.gate }]}
                          style={`left:${ax.at(s.v!)}`}
                          title={`${r.model}, SFT: ${fmt(s.v!)}${s.gate ? ' (below the parse gate)' : ''}`}
                        />
                      )}
                      {!has(s) && <span class="rs-status">SFT {statusText[s.status!]}</span>}
                    </span>
                    <span class="rs-vals">
                      <span class="rs-from">
                        <span class:list={{ 'rs-tie': z.bold }}>{has(z) ? `${fmt(z.v!)}${z.gate ? '×' : ''}` : '–'}</span>
                        <span class="rs-arrow">→</span>
                      </span>
                      <span class:list={{ 'rs-tie': s.bold }}>{has(s) ? `${fmt(s.v!)}${s.gate ? '×' : ''}` : '–'}</span>
                    </span>
                  </Fragment>
                );
              })}
              <span />
              <span class="rs-axis" aria-hidden="true">
                {ax.ticks.map((t, i) => (
                  <span class:list={{ 'rs-tick-odd': i % 2 === 1 }} style={`left:${ax.at(t)}`}>
                    {fmt(t).replace(/\.0$/, '')}
                  </span>
                ))}
              </span>
              <span />
            </div>
            <p class="rs-note">
              {`After SFT, ${shift.up} ${shift.up === 1 ? 'model improves' : 'models improve'}, ${shift.down} ${shift.down === 1 ? 'declines' : 'decline'}${shift.same > 0 ? `, ${shift.same} unchanged` : ''}.`}
              {gated > 0 && ` ${gated} of the ${zeroShotSft.models.length * 2} runs fell below the parse gate (×), so those scores describe output that mostly failed to parse.`}
              {has(teacher) && ` Dashed line: the teacher at ${fmt(teacher.v!)}${teacher.self ? ', self-judged' : ''}.`}
            </p>
            <details class="rs-table">
              <summary>Table</summary>
              <table>
                <thead>
                  <tr>
                    <th>Model</th>
                    <th>Zero-shot</th>
                    <th>SFT</th>
                  </tr>
                </thead>
                <tbody>
                  {zeroShotSft.models.map((r) => (
                    <tr>
                      <td>{r.model}</td>
                      {[r.zeroShot[m.key], r.sft[m.key]].map((c) => (
                        <td class:list={{ 'rs-tie': c.bold }}>
                          {has(c) ? `${fmt(c.v!)}${c.gate ? '×' : ''}` : statusText[c.status!]}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          </div>
        ))
      }
    </section>

    <!-- B. Qwen3.5-9B through every stage. -->
    <section class="rs-card" aria-label="Qwen3.5-9B through every stage">
      <header class="rs-head">
        <h4>Qwen3.5-9B through every stage</h4>
        <span class="rs-meta">every arm trains from the same merged SFT base</span>
      </header>
      <p class="rs-legend">
        <span><span class="rs-key rs-key-sft"></span>reported GRPO and KTO models</span>
        <span><span class="rs-key rs-key-ink"></span>other arms</span>
        <span><span class="rs-key-line"></span>SFT base</span>
      </p>
      {
        panels.map(({ m, ax, fmt, base }) => (
          <div class:list={['rs-panel', { 'is-on': m.key === first }]} data-panel={m.key}>
            <div class="rs-plot" style={`grid-template-rows: repeat(${rlRows}, auto) auto`}>
              <div class="rs-grid" style={`grid-row: 1 / ${rlRows + 1}`} aria-hidden="true">
                {ax.ticks.map((t) => (
                  <span class="rs-gridline" style={`left:${ax.at(t)}`} />
                ))}
                {has(base) && <span class="rs-refline" style={`left:${ax.at(base.v!)}`} />}
              </div>
              {rlGroups.map((g) => (
                <Fragment>
                  {g.label && <span class="rs-group">{g.label}</span>}
                  {g.rows.map((r) => {
                    const c = r.cells[m.key];
                    return (
                      <Fragment>
                        <span class:list={['rs-label', { 'rs-label-strong': r.kind === 'reported' }]}>{r.arm}</span>
                        <span class="rs-track">
                          {has(c) && (
                            <span
                              class:list={[
                                'rs-dot',
                                r.kind === 'reported' ? 'rs-dot-sft' : r.kind === 'ref' ? 'rs-dot-ref' : 'rs-dot-ink',
                                { 'is-gate': c.gate },
                              ]}
                              style={`left:${ax.at(c.v!)}`}
                              title={`${r.arm}: ${fmt(c.v!)}${c.gate ? ' (below the parse gate)' : ''}`}
                            />
                          )}
                        </span>
                        <span class="rs-vals">
                          <span class:list={{ 'rs-tie': c.bold }}>{has(c) ? `${fmt(c.v!)}${c.gate ? '×' : ''}` : '–'}</span>
                        </span>
                      </Fragment>
                    );
                  })}
                </Fragment>
              ))}
              <span />
              <span class="rs-axis" aria-hidden="true">
                {ax.ticks.map((t, i) => (
                  <span class:list={{ 'rs-tick-odd': i % 2 === 1 }} style={`left:${ax.at(t)}`}>
                    {fmt(t).replace(/\.0$/, '')}
                  </span>
                ))}
              </span>
              <span />
            </div>
            <details class="rs-table">
              <summary>Table</summary>
              <table>
                <thead>
                  <tr>
                    <th>Arm</th>
                    <th>{m.name}</th>
                  </tr>
                </thead>
                <tbody>
                  {rlStage.map((r) => {
                    const c = r.cells[m.key];
                    return (
                      <tr>
                        <td>{r.arm}</td>
                        <td class:list={{ 'rs-tie': c.bold }}>{has(c) ? `${fmt(c.v!)}${c.gate ? '×' : ''}` : statusText[c.status!]}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </details>
          </div>
        ))
      }
      <p class="rs-note">
        Same axis as the card above. On PrivacyLens, the one benchmark where we measure re-run noise directly,
        six sampling seeds move QA accuracy by ±2.4–2.7 points, adjusted leakage by ±1.6–2.2, and helpfulness by
        ±1.5–1.9. Neither the reward components nor the kind of preference label moves a benchmark beyond that noise. 
      </p>
    </section>
  </div>

  <!-- C. Held-out normative alignment. -->
  <section class="rs-card rs-ground" aria-label="Held-out normative alignment">
    <header class="rs-head">
      <h4>Where grounding shows: held-out normative alignment</h4>
      <span class="rs-meta">503 chunks unseen by both RL arms</span>
    </header>
    <p class="rs-lead">
      Each model re-runs the extraction and labels each flow itself, with no norm in context. κ measures how far that
      label agrees with the label grounded in the novel’s own norms, beyond chance within each novel.
    </p>
    <div class="rs-plot" style={`grid-template-rows: repeat(${grounding.length}, auto) auto`}>
      <div class="rs-grid" style={`grid-row: 1 / ${grounding.length + 1}`} aria-hidden="true">
        {gAxis.ticks.map((t) => <span class:list={['rs-gridline', { 'rs-zero': t === 0 }]} style={`left:${gAt(t)}`} />)}
      </div>
      {
        grounding.map((g) => (
          <Fragment>
            <span class:list={['rs-label', { 'rs-label-strong': g.kind === 'reported' }]}>{g.extractor}</span>
            <span class="rs-track">
              <span class="rs-whisker" style={`left:${gAt(g.ci[0])}; right:calc(100% - ${gAt(g.ci[1])})`} />
              <span
                class:list={[
                  'rs-dot',
                  g.kind === 'reported' ? 'rs-dot-sft' : g.kind === 'ref' || g.kind === 'teacher' ? 'rs-dot-ref' : 'rs-dot-ink',
                ]}
                style={`left:${gAt(g.kappa)}`}
                title={`${g.extractor}: κ ${k3(g.kappa)} [${k3(g.ci[0])}, ${k3(g.ci[1])}]`}
              />
            </span>
            <span class="rs-vals">
              <span class:list={{ 'rs-tie': g.bold }}>{k3(g.kappa)}</span>
            </span>
          </Fragment>
        ))
      }
      <span />
      <span class="rs-axis" aria-hidden="true">
        {
          gAxis.ticks.map((t, i) => (
            <span class:list={{ 'rs-tick-odd': i % 2 === 1 }} style={`left:${gAt(t)}`}>
              {t === 0 ? '0' : t.toFixed(2)}
            </span>
          ))
        }
      </span>
      <span />
    </div>
    <p class="rs-note">
      Cohen’s κ with 95% bootstrap intervals that resample whole novels (10 books, so read them as coarse). SFT trained on
      every chunk and only imitates the teacher’s ungrounded labels; GRPO and KTO roughly double its alignment on text
      neither saw.
    </p>
    <details class="rs-table">
      <summary>Table</summary>
      <table>
        <thead>
          <tr>
            <th>Extractor</th>
            <th>Flows</th>
            <th>κ</th>
            <th>95% CI</th>
          </tr>
        </thead>
        <tbody>
          {
            grounding.map((g) => (
              <tr>
                <td>{g.extractor}</td>
                <td>{g.flows.toLocaleString('en-US')}</td>
                <td class:list={{ 'rs-tie': g.bold }}>{k3(g.kappa)}</td>
                <td>
                  [{k3(g.ci[0])}, {k3(g.ci[1])}]
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </details>
  </section>

  <p class="rs-foot">
    Values are percentages except CI-RL net score (−1 to 1) and κ. <b>Bold</b> values are the paper’s statistical tie
    set: re-run noise cannot separate them from the best value in their table’s column. × marks a run below the
    benchmark’s 70% strict-format parse gate. All judged metrics use Gemma-4-31B-it.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rs]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.rs-tab');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const key = tab.dataset.metric;
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        panels.forEach((p) => p.classList.toggle('is-on', p.dataset.panel === key));
      }),
    );
  });
</script>

<style>
  .rs {
    --rs-ink-faint: rgba(var(--color-text-base), 0.16);
    --rs-ink-soft: rgba(var(--color-text-base), 0.4);
    margin-top: 2rem;
  }

  /* Metric buttons, one row of groups above the charts. */
  .rs-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin: 0 auto 1rem;
  }
  .rs-tab-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rs-tab-bench {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .rs-tab-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .rs-tab {
    padding: 0.25rem 0.65rem;
    border: 1.5px solid var(--rs-ink-faint);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .rs-tab:hover {
    border-color: var(--rs-ink-soft);
  }
  .rs-tab[aria-pressed='true'] {
    border-color: rgb(var(--color-accent));
    background: rgba(var(--color-accent), 0.12);
    font-weight: 700;
  }
  .rs-down {
    opacity: 0.7;
  }

  [data-panel]:not(.is-on) {
    display: none;
  }
  .rs-metric {
    max-width: 46rem;
    margin: 0 auto 1rem;
    font-size: 0.9rem;
    text-align: center;
  }

  /* Cards. */
  .rs-cards {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 1000px) {
    .rs-cards {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .rs-card {
    min-width: 0;
    padding: 0.9rem 1rem 1rem;
    border: 1.5px solid var(--rs-ink-faint);
    border-radius: 0.6rem;
    background: rgb(var(--color-card));
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .rs-ground {
    max-width: 40rem;
    margin: 1rem auto 0;
  }
  .rs-ground .rs-plot {
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) 4rem;
  }
  .rs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 0.75rem;
    margin: 0 0 0.5rem;
  }
  .rs-head h4 {
    margin: 0;
    font-size: 0.95rem;
  }
  .rs-meta {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .rs-lead {
    margin: 0 0 0.6rem;
  }
  .rs-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
  }
  .rs-key {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    vertical-align: -0.05rem;
  }
  .rs-key-ref {
    background: rgba(var(--color-text-base), 0.35);
  }
  .rs-key-sft {
    background: rgb(var(--color-accent));
  }
  .rs-key-ink {
    background: rgba(var(--color-text-base), 0.75);
  }
  .rs-key-gate {
    border: 2px solid rgba(var(--color-text-base), 0.6);
  }
  .rs-key-line {
    display: inline-block;
    width: 0;
    height: 0.8rem;
    margin: 0 0.4rem 0 0.25rem;
    border-left: 1.5px dashed rgb(var(--color-text-base));
    vertical-align: -0.1rem;
  }

  /* Dot plot: label | track | values, one grid so the gridlines span every row. */
  .rs-plot {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr) 6.2rem;
    align-items: center;
    column-gap: 0.75rem;
  }
  /* Absolutely positioned in its grid area, so it takes no cells from the rows. */
  .rs-grid {
    position: absolute;
    inset: 0;
    grid-column: 2 / 3;
  }
  .rs-gridline,
  .rs-refline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }
  .rs-gridline {
    border-left: 1px solid var(--rs-ink-faint);
  }
  .rs-zero {
    border-left-color: var(--rs-ink-soft);
  }
  .rs-refline {
    border-left: 1.5px dashed rgb(var(--color-text-base));
    opacity: 0.7;
  }
  .rs-label {
    grid-column: 1;
    overflow: hidden;
    font-size: 0.8rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .rs-label-strong {
    font-weight: 700;
  }
  .rs-group {
    grid-column: 1 / -1;
    margin-top: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .rs-track {
    position: relative;
    grid-column: 2;
    height: 1.5rem;
  }
  .rs-span,
  .rs-whisker {
    position: absolute;
    top: calc(50% - 1px);
    height: 2px;
